# Copy to .env (never commit it). Leave DATABASE_URL unset to use SQLite local.db.
# Supabase: Project Settings > Database > Connection string > "Session pooler" (IPv4-friendly).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Firebase Console > Project settings > Service accounts > Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# ...or paste the whole JSON (this is what the GitHub Actions secret holds):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
